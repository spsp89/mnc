# Web
BNC_API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_BNC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Publish store buttons only after the release validator passes with both live listings.
NEXT_PUBLIC_MOBILE_APP_RELEASE_ENABLED=false
NEXT_PUBLIC_MAPBOX_TOKEN=
# Official HTTPS release pages only. Leave blank until the listings are live.
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_IOS_APP_URL=

# PostgreSQL + Prisma
DATABASE_URL=postgresql://bnc:bnc_dev_password@localhost:5432/bnc?schema=public
DIRECT_DATABASE_URL=postgresql://bnc:bnc_dev_password@localhost:5432/bnc?schema=public
# Bound connection establishment and every Prisma query/statement.
DATABASE_QUERY_TIMEOUT_MS=5000
# Fail readiness quickly when the database accepts TCP but does not answer queries.
HEALTH_READINESS_TIMEOUT_MS=3000

# Redis + background jobs
REDIS_URL=redis://localhost:6379

# Authentication and encryption
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ENQUIRY_DATA_KEY=replace-with-a-strong-encryption-key
FINGERPRINT_KEY=replace-with-a-different-strong-hmac-key
OTP_HASH_SECRET=replace-with-an-otp-hash-secret
# Testing only. When true, every requested phone challenge uses 123456 and no SMS is queued.
TEST_FIXED_OTP_ENABLED=true
DRAW_CODE_SECRET=replace-with-a-different-strong-hmac-key
# Keep disabled until legal/tax/eligibility approval is recorded.
DRAW_FEATURE_ENABLED=false
DRAW_LEGAL_APPROVAL_REFERENCE=

# Object storage (S3-compatible: AWS S3 or Cloudflare R2)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_BUCKET=bnc-media-015872246618-ap-south-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_URL=
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
OBJECT_STORAGE_MAX_IMAGE_BYTES=10000000
OBJECT_STORAGE_MAX_DOCUMENT_BYTES=5000000

# Maps, messaging, payments and push
MAPBOX_ACCESS_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
# One-line Firebase service-account JSON used by the API push dispatcher.
FIREBASE_SERVICE_ACCOUNT_JSON=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
# Official WhatsApp provider adapter. Disabled means no messages leave BNC.
WHATSAPP_PROVIDER=DISABLED
WHATSAPP_API_BASE_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SEND_PATH=/messages
# HMAC-SHA256 secret for x-bnc-whatsapp-signature callback verification.
WHATSAPP_WEBHOOK_SECRET=
# NotificationType -> provider-approved template name. Do not add unapproved copy.
WHATSAPP_APPROVED_TEMPLATES_JSON={}
WHATSAPP_DAILY_LIMIT=3

# Delivery provider adapter (MANUAL, PORTER or HTTP)
DELIVERY_PROVIDER=MANUAL
DELIVERY_API_BASE_URL=
DELIVERY_API_TOKEN=
DELIVERY_QUOTE_PATH=/quotes
DELIVERY_CREATE_PATH=/deliveries
DELIVERY_STATUS_PATH=/deliveries/{id}
DELIVERY_CANCEL_PATH=/deliveries/{id}/cancel
# HMAC-SHA256 secret used to verify the raw provider webhook body.
DELIVERY_WEBHOOK_SECRET=

# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Must exceed DATABASE_QUERY_TIMEOUT_MS so the API can return its controlled error.
BNC_API_REQUEST_TIMEOUT_MS=7000
LOG_LEVEL=info
