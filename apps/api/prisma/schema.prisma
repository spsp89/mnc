  deliveryShipment DeliveryShipment?
  review           Review?

  @@index([customerId, status, createdAt])
  @@index([businessId, status, createdAt])
  @@unique([businessId, externalReference])
  @@index([source, createdAt])
  @@index([createdById, createdAt])
}

model DeliveryShipment {
  id            String                 @id @default(cuid())
  orderId       String                 @unique
  businessId    String
  customerId    String
  provider      String
  providerRef   String?
  status        DeliveryShipmentStatus @default(QUOTED)
  quotedAmount  Decimal?               @db.Decimal(12, 2)
  currency      String                 @default("INR")
  trackingUrl   String?
  driverName    String?
  driverPhone   String?
  vehicleNumber String?
  providerData  Json?
  requestedAt   DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  lastSyncedAt  DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business      Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      User                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  proof         DeliveryProof?
  settlement    DeliverySettlement?

  @@index([businessId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([provider, providerRef])
}

model DeliveryProof {
  id           String           @id @default(cuid())
  shipmentId   String           @unique
  objectKey    String?
  receiverName String
  notes        String?
  latitude     Decimal?         @db.Decimal(10, 7)
  longitude    Decimal?         @db.Decimal(10, 7)
  capturedAt   DateTime         @default(now())
  capturedById String
  shipment     DeliveryShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  capturedBy   User             @relation(fields: [capturedById], references: [id])

  @@index([capturedById, capturedAt])
  @@index([capturedAt])
}

model DeliverySettlement {
  id          String                   @id @default(cuid())
  shipmentId  String                   @unique
  status      DeliverySettlementStatus @default(PENDING)
  grossAmount Decimal                  @db.Decimal(12, 2)
  providerFee Decimal                  @default(0) @db.Decimal(12, 2)
  netPayable  Decimal                  @db.Decimal(12, 2)
  currency    String                   @default("INR")
  reference   String?
  notes       String?
  readyAt     DateTime?
  settledAt   DateTime?
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  shipment    DeliveryShipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation(fields: [createdById], references: [id])

  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  nameSnapshot String
  skuSnapshot  String?
  quantity     Int
  unitPrice    Decimal         @db.Decimal(12, 2)
  total        Decimal         @db.Decimal(12, 2)
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String                @id @default(cuid())
  orderId           String?
  subscriptionId    String?
  provider          String
  providerPaymentId String?               @unique
  idempotencyKey    String                @unique
  amount            Decimal               @db.Decimal(12, 2)
  currency          String                @default("INR")
  status            PaymentStatus         @default(CREATED)
  capturedAt        DateTime?
  failedAt          DateTime?
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  order             Order?                @relation(fields: [orderId], references: [id])
  subscription      BusinessSubscription? @relation(fields: [subscriptionId], references: [id])
  refunds           Refund[]
  statusHistory     PaymentStatusHistory[]

  @@index([orderId, status])
  @@index([subscriptionId, status])
  @@index([createdAt])
}

model PaymentStatusHistory {
  id              String        @id @default(cuid())
  paymentId       String
  previousStatus  PaymentStatus?
  newStatus       PaymentStatus
  source          String
  sourceReference String?
  actorId         String?
  reason          String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([newStatus, createdAt])
  @@index([source, sourceReference])
}

model WebhookEvent {
  id          String             @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payloadHash String
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  updatedAt   DateTime           @updatedAt

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([eventType, receivedAt])
}

model Settlement {
  id                   String    @id @default(cuid())
  businessId           String
  periodStart          DateTime
  periodEnd            DateTime
  grossAmount          Decimal   @db.Decimal(12, 2)
  commissionAmount     Decimal   @db.Decimal(12, 2)
  taxAmount            Decimal   @db.Decimal(12, 2)
  netAmount            Decimal   @db.Decimal(12, 2)
  status               String
  providerSettlementId String?   @unique
  settledAt            DateTime?
  createdAt            DateTime  @default(now())
  business             Business  @relation(fields: [businessId], references: [id])

  @@index([businessId, periodStart, periodEnd])
  @@index([status, createdAt])
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String?
  paymentId        String
  amount           Decimal      @db.Decimal(12, 2)
  reason           String
  status           RefundStatus @default(REQUESTED)
  source           String       @default("PROVIDER")
  method           String?
  externalReference String?
  requestedById    String?
  notes             String?
  failureReason     String?
  metadata          Json?
  providerRefundId String?      @unique
  requestedAt      DateTime     @default(now())
  completedAt      DateTime?
  updatedAt        DateTime     @updatedAt
  order            Order?       @relation(fields: [orderId], references: [id])
  payment          Payment      @relation(fields: [paymentId], references: [id])

  @@index([orderId, status])
  @@index([paymentId, status])
  @@index([source, status, requestedAt])
  @@index([requestedById, requestedAt])
}

model VerificationRequest {
  id              String             @id @default(cuid())
  businessId      String
  requestedById   String
  reviewerId      String?
  status          VerificationStatus @default(PENDING)
  documentType    String
  documentKey     String
  documentHash    String
  notes           String?
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewer        User?              @relation("VerificationReviewer", fields: [reviewerId], references: [id])

  @@index([status, createdAt])
  @@index([businessId, status])
  @@index([reviewerId, status])
}

model Advertisement {
  id          String              @id @default(cuid())
  businessId  String?
  title       String
  placement   String
  target      Json
  creativeKey String?
  destination String
  budget      Decimal             @db.Decimal(12, 2)
  spent       Decimal             @default(0) @db.Decimal(12, 2)
  status      AdvertisementStatus @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime
  impressions Int                 @default(0)
  clicks      Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  business    Business?           @relation(fields: [businessId], references: [id])

  @@index([status, startsAt, endsAt])
  @@index([businessId, status])
  @@index([placement, status])
}

model Banner {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  ctaText      String?
  ctaUrl       String?
  placement    String
  imageKey     String
  imageUrl     String
  startsAt     DateTime?
  endsAt       DateTime?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(false)
  createdById  String
  updatedById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([placement, isActive, displayOrder])
  @@index([isActive, startsAt, endsAt])
}

model SupportTicket {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  userId       String?
  assignedToId String?
  subject      String
  category     String
  priority     String
  status       TicketStatus @default(OPEN)
  description  String
  metadata     Json?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User?        @relation(fields: [userId], references: [id])

  @@index([status, priority, createdAt])
  @@index([userId, createdAt])
  @@index([assignedToId, status])
}

model Translation {
  id             String            @id @default(cuid())
  entityType     String
  entityId       String
  field          String
  sourceLanguage String
  targetLanguage String
  originalText   String
  translatedText String
  provider       String?
  status         TranslationStatus @default(AUTOMATIC)
  translatedAt   DateTime          @default(now())
  correctedAt    DateTime?
  correctedById  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([entityType, entityId, field, targetLanguage])
  @@index([status, targetLanguage])
  @@index([entityType, entityId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  reason       String?
  before       Json?
  after        Json?
  ipAddress    String?
  userAgent    String?
  requestId    String
  previousHash String?
  entryHash    String   @unique
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceName String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model Consent {
  id          String    @id @default(cuid())
  userId      String
  type        String
  scope       Json
  granted     Boolean
  source      String
  ipAddress   String?
  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, grantedAt])
}

model RankingConfiguration {
  id          String    @id @default(cuid())
  name        String
  version     Int       @unique
  weights     Json
  active      Boolean   @default(false)
  createdById String
  reason      String
  activatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([active, version])
}
