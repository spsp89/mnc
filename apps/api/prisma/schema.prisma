generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  SUPER_ADMIN
  STATE_ADMIN
  DISTRICT_ADMIN
  AREA_MANAGER
  VERIFICATION
  MODERATOR
  SUPPORT
  SALES
  FINANCE
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum ProductStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum BusinessStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
  DISABLED
}

enum ManagedLocationType {
  COUNTRY
  STATE
  DISTRICT
  CITY
  CONSTITUENCY
  LOCALITY
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  MORE_INFORMATION
  APPROVED
  REJECTED
  EXPIRED
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  PAUSED
  CANCELLED
  EXPIRED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum AnalyticsEventType {
  SEARCH_IMPRESSION
  PROFILE_VIEW
  CALL_CLICK
  WHATSAPP_CLICK
  DIRECTIONS_CLICK
  SAVE_BUSINESS
  ENQUIRY_START
  ENQUIRY_SUBMITTED
}

enum LeadStatus {
  NEW
  MATCHING
  DELIVERED
  VIEWED
  ACCEPTED
  CONTACTED
  CONVERTED
  EXPIRED
  REJECTED
  SPAM
}

enum AssignmentStatus {
  QUEUED
  DELIVERED
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum EnquiryStatus {
  SUBMITTED
  MATCHING
  RESPONDED
  CLOSED
  EXPIRED
  SPAM
}

enum MerchantEnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
  SPAM
}

enum OfferModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationStatus {
  OPEN
  ARCHIVED
  BLOCKED
  CLOSED
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  SYSTEM
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  FLAGGED
  REMOVED
}

enum NotificationChannel {
  IN_APP
  BROWSER_PUSH
  MOBILE_PUSH
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationType {
  NEW_LEAD
  NEW_ENQUIRY
  NEARBY_OFFER
  WEEKLY_DRAW
  CUSTOMER_RESPONSE
  REVIEW_RECEIVED
  REVIEW_REPLY
  ORDER_UPDATE
  SUBSCRIPTION_RENEWAL
  PAYMENT_CONFIRMATION
  OFFER_EXPIRY
  VERIFICATION_UPDATE
  SUPPORT_UPDATE
  BOOKING_REMINDER
}

enum PlanOfferReach {
  NEARBY_5KM
  DISTRICT
  STATE
}

enum PlanListingReach {
  NEARBY_5KM
  CONSTITUENCY
  DISTRICT
  STATE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum JobApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

enum ReferralStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum WeeklyDrawStatus {
  DRAFT
  OPEN
  DRAWN
  PUBLISHED
  CANCELLED
}

enum DrawKind {
  WEEKLY
  MONTHLY
  FESTIVAL
}

enum DrawEntryStatus {
  ISSUED
  CLAIMED
  VOIDED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ClubMembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum ClubEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ClubEventRegistrationStatus {
  ATTENDING
  CANCELLED
}

enum DeliveryShipmentStatus {
  QUOTED
  REQUESTED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

enum DeliverySettlementStatus {
  PENDING
  READY
  SETTLED
  DISPUTED
}

enum PricingType {
  FIXED
  STARTING_AT
  HOURLY
  DAILY
  PER_UNIT
  QUOTE
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  MADE_TO_ORDER
}

enum OfferType {
  PERCENTAGE
  FLAT
  FESTIVAL
  LIMITED_TIME
  COUPON
  COMBO
  NEW_CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum AdvertisementStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TranslationStatus {
  AUTOMATIC
  REVIEWED
  MANUALLY_CORRECTED
}

model User {
  id                         String                   @id @default(cuid())
  phone                      String?                  @unique
  email                      String?                  @unique
  passwordHash               String?
  phoneVerifiedAt            DateTime?
  emailVerifiedAt            DateTime?
  role                       UserRole                 @default(CUSTOMER)
  status                     UserStatus               @default(PENDING)
  preferredLanguage          String                   @default("en") @db.VarChar(5)
  lastLoginAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  deletedAt                  DateTime?
  customerProfile            CustomerProfile?
  businessOwner              BusinessOwner?
  businessMemberships        BusinessMember[]
  savedBusinesses            SavedBusiness[]
  savedProducts              SavedProduct[]
  addresses                  SavedAddress[]
  recentlyViewed             RecentlyViewedBusiness[]
  blockedBusinesses          BlockedBusiness[]
  searchHistory              SearchHistory[]
  enquiries                  Enquiry[]
  leads                      Lead[]
  conversations              ConversationMember[]
  messages                   Message[]
  reviews                    Review[]
  reviewHelpfulVotes         ReviewHelpfulVote[]
  reviewReports              ReviewReport[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  pushDevices                PushDevice[]
  orders                     Order[]
  supportTickets             SupportTicket[]
  refreshSessions            RefreshSession[]
  consents                   Consent[]
  verificationReviews        VerificationRequest[]    @relation("VerificationReviewer")
  auditLogs                  AuditLog[]               @relation("AuditActor")
  roleAssignments            GlobalRoleAssignment[]
  jobApplications            JobApplication[]
  referralsCreated           BusinessReferral[]       @relation("ReferralCreator")
  weeklyDrawWins             WeeklyDraw[]             @relation("WeeklyDrawWinner")
  drawEntriesIssued          DrawEntry[]              @relation("DrawEntryIssuer")
  drawEntriesClaimed         DrawEntry[]              @relation("DrawEntryCustomer")
  clubMemberships            ClubMembership[]
  clubMessages               ClubMessage[]
  clubEventsCreated          ClubEvent[]
  clubReferralsCreated       ClubReferral[]
  bookings                   Booking[]
  deliveryShipments          DeliveryShipment[]
  deliveryProofsCaptured     DeliveryProof[]
  deliverySettlementsCreated DeliverySettlement[]
  targetedOffers             Offer[]                    @relation("TargetedOfferCustomer")

  @@index([role, status])
  @@index([createdAt])
  @@index([deletedAt])
}

model GlobalRoleAssignment {
  id           String    @id @default(cuid())
  userId       String
  role         UserRole
  assignedById String?
  reason       String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, active])
  @@index([assignedById])
}

model CustomerProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  displayName  String?
  avatarUrl    String?
  dateOfBirth  DateTime?
  defaultCity  String?
  defaultState String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessOwner {
  id         String     @id @default(cuid())
  userId     String     @unique
  legalName  String
  panNumber  String?
  gstNumber  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businesses Business[]
}

model Business {
  id                       String                   @id @default(cuid())
  ownerId                  String
  name                     String
  slug                     String                   @unique
  legalName                String?
  description              String
  shortDescription         String?
  logoUrl                  String?
  coverImageUrl            String?
  phoneEncrypted           String?
  publicPhone              String?
  whatsappEncrypted        String?
  email                    String?
  websiteUrl               String?
  socialLinks              Json?
  permanentDiscountPercent Int?
  permanentDiscountLabel   String?
  status                   BusinessStatus           @default(DRAFT)
  listingStatus            ListingStatus            @default(DRAFT)
  verified                 Boolean                  @default(false)
  premium                  Boolean                  @default(false)
  profileCompleteness      Int                      @default(0)
  averageRating            Decimal                  @default(0) @db.Decimal(3, 2)
  reviewCount              Int                      @default(0)
  responseRate             Decimal                  @default(0) @db.Decimal(5, 2)
  medianResponseMinutes    Int?
  yearsInBusiness          Int?
  priceRange               Int?
  attributes               Json?
  tags                     String[]                 @default([])
  seoTitle                 String?
  seoDescription           String?
  searchDocument           String?
  lastActiveAt             DateTime?
  publishedAt              DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  deletedAt                DateTime?
  owner                    BusinessOwner            @relation(fields: [ownerId], references: [id])
  locations                BusinessLocation[]
  categories               BusinessCategory[]
  media                    BusinessMedia[]
  members                  BusinessMember[]
  workingHours             WorkingHour[]
  products                 Product[]
  services                 Service[]
  offers                   Offer[]
  subscriptions            BusinessSubscription[]
  leadAssignments          LeadAssignment[]
  enquiries                Enquiry[]
  merchantEnquiryStates    MerchantEnquiryState[]
  conversations            Conversation[]
  reviews                  Review[]
  savedBy                  SavedBusiness[]
  viewedBy                 RecentlyViewedBusiness[]
  blockedBy                BlockedBusiness[]
  verificationRequests     VerificationRequest[]
  advertisements           Advertisement[]
  orders                   Order[]
  settlements              Settlement[]
  jobs                     Job[]
  referrals                BusinessReferral[]
  clubMemberships          ClubMembership[]
  bookings                 Booking[]
  bookingProviders         BookingProvider[]
  bookingSchedules         BookingSchedule[]
  deliveryShipments        DeliveryShipment[]
  drawEntries              DrawEntry[]

  @@index([status, listingStatus, verified, premium])
  @@index([averageRating, reviewCount])
  @@index([ownerId])
  @@index([lastActiveAt])
  @@index([createdAt])
  @@index([deletedAt])
}

model BusinessLocation {
  id              String                                @id @default(cuid())
  businessId      String
  managedLocationId String?
  label           String?
  addressLine1    String
  addressLine2    String?
  locality        String
  city            String
  constituency    String?
  district        String
  state           String
  postalCode      String
  latitude        Decimal                               @db.Decimal(10, 7)
  longitude       Decimal                               @db.Decimal(10, 7)
  locationPoint   Unsupported("geography(Point,4326)")?
  serviceRadiusKm Int                                   @default(5)
  isPrimary       Boolean                               @default(false)
  isActive        Boolean                               @default(true)
  createdAt       DateTime                              @default(now())
  updatedAt       DateTime                              @updatedAt
  business        Business                              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  managedLocation ManagedLocation?                      @relation(fields: [managedLocationId], references: [id], onDelete: SetNull)

  @@index([businessId, isPrimary])
  @@index([managedLocationId, isActive])
  @@index([state, district, constituency, city, locality])
  @@index([latitude, longitude])
}

model ManagedLocation {
  id          String              @id @default(cuid())
  name        String
  slug        String
  type        ManagedLocationType
  parentId    String?
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  latitude    Decimal?            @db.Decimal(10, 7)
  longitude   Decimal?            @db.Decimal(10, 7)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  parent      ManagedLocation?    @relation("ManagedLocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    ManagedLocation[]   @relation("ManagedLocationTree")
  businesses  BusinessLocation[]

  @@unique([parentId, slug])
  @@index([type, isActive, sortOrder])
  @@index([parentId, isActive, sortOrder])
}

model Category {
  id                String             @id @default(cuid())
  name              String
  nameMalayalam     String?
  slug              String             @unique
  description       String?
  icon              String?
  level             Int                @default(0)
  sortOrder         Int                @default(0)
  isActive          Boolean            @default(true)
  customFieldSchema Json?
  parentId          String?
  parent            Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[]         @relation("CategoryTree")
  businessLinks     BusinessCategory[]
  products          Product[]
  services          Service[]
  leads             Lead[]
  enquiries         Enquiry[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([parentId, sortOrder])
  @@index([isActive, level])
}

model BusinessCategory {
  businessId String
  categoryId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@index([categoryId, isPrimary])
}

model BusinessMember {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  role        String
  permissions Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId, active])
}

model BusinessMedia {
  id         String   @id @default(cuid())
  businessId String
  objectKey  String
  publicUrl  String
  mediaType  String
  altText    String?
  sortOrder  Int      @default(0)
  scanStatus String   @default("pending")
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, mediaType, sortOrder])
}

model WorkingHour {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  opensAt    String?
  closesAt   String?
  closed     Boolean  @default(false)
  splitHours Json?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

model Product {
  id                String           @id @default(cuid())
  businessId        String
  categoryId        String
  name              String
  slug              String
  brand             String?
  description       String
  price             Decimal          @db.Decimal(12, 2)
  discountPrice     Decimal?         @db.Decimal(12, 2)
  stockStatus       StockStatus      @default(IN_STOCK)
  minimumOrderQty   Int              @default(1)
  deliveryOptions   Json?
  specifications    Json?
  warranty          String?
  returnInformation String?
  status            ProductStatus    @default(DRAFT)
  submittedAt       DateTime?
  publishedAt       DateTime?
  moderationReason  String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category          Category         @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  orderItems        OrderItem[]
  offers            OfferProduct[]
  enquiryItems      EnquiryItem[]
  media             ProductMedia[]
  savedBy           SavedProduct[]

  @@unique([businessId, slug])
  @@index([categoryId, isActive, stockStatus])
  @@index([businessId, isActive])
  @@index([brand])
  @@index([deletedAt])
}

model ProductMedia {
  id         String   @id @default(cuid())
  productId  String
  objectKey  String
  publicUrl  String?
  mediaType  String
  altText    String?
  sortOrder  Int      @default(0)
  scanStatus String   @default("pending")
  variant    String   @default("gallery")
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, objectKey])
  @@index([productId, mediaType, sortOrder])
  @@index([scanStatus])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  name       String
  sku        String      @unique
  price      Decimal?    @db.Decimal(12, 2)
  stock      Int         @default(0)
  attributes Json
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId, isActive])
}

model Service {
  id               String                   @id @default(cuid())
  businessId       String
  categoryId       String
  name             String
  slug             String
  description      String
  startingPrice    Decimal?                 @db.Decimal(12, 2)
  pricingType      PricingType              @default(STARTING_AT)
  durationMinutes  Int?
  homeService      Boolean                  @default(false)
  availability     Json?
  serviceAreas     Json?
  bookingQuestions Json?
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?
  business         Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category         Category                 @relation(fields: [categoryId], references: [id])
  offers           OfferService[]
  enquiryItems     EnquiryItem[]
  media            ServiceMedia[]
  bookings         Booking[]
  bookingProviders BookingProviderService[]
  bookingSchedules BookingSchedule[]

  @@unique([businessId, slug])
  @@index([categoryId, isActive, homeService])
  @@index([businessId, isActive])
  @@index([deletedAt])
}

model ServiceMedia {
  id         String   @id @default(cuid())
  serviceId  String
  objectKey  String
  publicUrl  String?
  mediaType  String
  altText    String?
  sortOrder  Int      @default(0)
  scanStatus String   @default("pending")
  createdAt  DateTime @default(now())
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, objectKey])
  @@index([serviceId, mediaType, sortOrder])
  @@index([scanStatus])
}

model Offer {
  id              String         @id @default(cuid())
  businessId      String
  targetCustomerId String?
  source           String         @default("MERCHANT")
  createdById      String?
  title           String
  description     String
  type            OfferType
  discountValue   Decimal?       @db.Decimal(12, 2)
  couponCode      String?
  minimumSpend    Decimal?       @db.Decimal(12, 2)
  startsAt        DateTime
  endsAt          DateTime
  maxRedemptions  Int?
  redemptionCount Int            @default(0)
  isFeatured      Boolean        @default(false)
  featuredRequested Boolean      @default(false)
  isActive        Boolean        @default(true)
  moderationStatus OfferModerationStatus @default(PENDING)
  moderationReason String?
  moderatedAt      DateTime?
  moderatedById    String?
  notifiedAt      DateTime?
  targetedCount   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  targetCustomer  User?          @relation("TargetedOfferCustomer", fields: [targetCustomerId], references: [id], onDelete: Cascade)
  products        OfferProduct[]
  services        OfferService[]

  @@index([businessId, isActive, startsAt, endsAt])
  @@index([isActive, startsAt, endsAt])
  @@index([isFeatured, endsAt])
  @@index([featuredRequested, moderationStatus, createdAt])
  @@index([moderationStatus, isActive, startsAt, endsAt])
  @@index([targetCustomerId, moderationStatus, isActive, startsAt, endsAt])
  @@index([source, createdAt])
  @@index([couponCode])
}

model OfferProduct {
  offerId   String
  productId String
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
}

model OfferService {
  offerId   String
  serviceId String
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([offerId, serviceId])
}

model SubscriptionPlan {
  id                  String                 @id @default(cuid())
  name                String                 @unique
  slug                String                 @unique
  priority            Int                    @default(0)
  displayOrder        Int                    @default(0)
  starLevel           Int                    @default(0)
  listingReach        PlanListingReach       @default(NEARBY_5KM)
  offerReach          PlanOfferReach         @default(NEARBY_5KM)
  monthlyPrice        Decimal                @db.Decimal(12, 2)
  annualPrice         Decimal                @db.Decimal(12, 2)
  leadQuota           Int?
  offerLimit          Int?
  productLimit        Int?
  mediaLimit          Int?
  categoryLimit       Int                    @default(1)
  locationLimit       Int                    @default(1)
  teamMemberLimit     Int                    @default(1)
  descriptionEnabled  Boolean                @default(true)
  socialLinksEnabled  Boolean                @default(true)
  bookingEnabled      Boolean                @default(false)
  deliveryEnabled     Boolean                @default(false)
  automaticLeadAlerts Boolean                @default(false)
  sponsoredPlacement  Boolean                @default(false)
  advancedAnalytics   Boolean                @default(false)
  features            Json
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  subscriptions       BusinessSubscription[]

  @@index([isActive, priority])
  @@index([isActive, displayOrder])
}

model Job {
  id             String           @id @default(cuid())
  businessId     String
  title          String
  slug           String
  description    String
  employmentType String
  workplaceType  String           @default("ON_SITE")
  skills         Json
  salaryMin      Decimal?         @db.Decimal(12, 2)
  salaryMax      Decimal?         @db.Decimal(12, 2)
  currency       String           @default("INR")
  city           String
  district       String
  state          String
  applicationUrl String?
  contactEmail   String?
  status         JobStatus        @default(DRAFT)
  closesAt       DateTime?
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  applications   JobApplication[]

  @@unique([businessId, slug])
  @@index([status, city, publishedAt])
  @@index([businessId, status, createdAt])
  @@index([closesAt])
}

model JobApplication {
  id              String               @id @default(cuid())
  jobId           String
  applicantId     String?
  name            String
  email           String
  phone           String?
  coverNote       String?
  resumeObjectKey String?
  status          JobApplicationStatus @default(APPLIED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  job             Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant       User?                @relation(fields: [applicantId], references: [id])

  @@index([jobId, status, createdAt])
  @@index([applicantId, createdAt])
}

model BusinessReferral {
  id               String         @id @default(cuid())
  businessId       String
  createdById      String
  contactName      String
  referredBusiness String?
  phoneEncrypted   String?
  email            String?
  notes            String?
